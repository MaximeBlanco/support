APP_NAME=Support
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# artisan serve is single-process by default: without workers the interface
# freezes as soon as one request waits on another.
PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The hostnames below are the service names in compose.yaml, not localhost:
# the application talks to its neighbours from inside the Docker network.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=support
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=33060

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches every outgoing mail: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb carries the live updates. REVERB_HOST is how the application reaches it
# from inside Docker; VITE_REVERB_HOST is how the browser reaches it from outside.
REVERB_APP_ID=support
REVERB_APP_KEY=supportlocalkey
REVERB_APP_SECRET=supportlocalsecret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_FORWARD_PORT=8081

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
